grammar;

use crate::ast::*;

match {
    "if" => IF,
    "then" => THEN,
    "else" => ELSE,
    "while" => WHILE,
    "do" => DO,
    "not" => NOT,
    "and" => AND,
    "or" => OR,
    "int" => INT,
    "bool" => BOOL,
    "true" => TRUE,
    "false" => FALSE,
    "string" => STRING_TYPE,
    "float" => FLOAT_TYPE,
    "print" => PRINT,
    "for" => FOR,
    "to" => TO,
    "func" => FUNC,
    "return" => RETURN,
    "array" => ARRAY,                       // ← 新增数组关键字
} else {
    r"\s*" => {},
    r"//[^\n\r]*[\n\r]*" => {},
    r#""([^"\\]|\\.)*""# => STRING,
    r"[a-zA-Z_][a-zA-Z0-9_]*" => ID,
    r"[0-9]+\.[0-9]+" => FLOAT_NUM,
    r"[0-9]+" => INT_NUM,
    _
}

pub StmtList: Vec<Stmt> = {
    <l:StmtList> <s:Stmt> ";" => { let mut l = l; l.push(*s); l },
    <s:Stmt> ";" => vec![*s],
};

Stmt: Box<Stmt> = {
    IF <e:Expr> THEN <s:Block> => Box::new(Stmt::If(e, s)),
    IF <e:Expr> THEN <s:Block> ELSE <r:Block> => Box::new(Stmt::IfElse(e, s, r)),
    WHILE <e:Expr> DO <s:Block> => Box::new(Stmt::While(e, s)),
    <l:Expr> ":=" <r:Expr> => Box::new(Stmt::Assign(l, r)),    // ← 左侧改为任意 Expr
    <t:Type> <i:IdList> => Box::new(Stmt::VarDecl(i, t)),
    <b:Block> => Box::new(Stmt::Block(b)),
    <e:Expr> => Box::new(Stmt::Expr(e)),
    PRINT <e:Expr> => Box::new(Stmt::Print(e)),
    FOR <var:Id> ":=" <from:Expr> TO <to:Expr> DO <body:Block> => 
        Box::new(Stmt::For(var, from, to, body)),
    <start:@L> FUNC <name:Id> "(" <params:ParamList> ")" "->" <ret_type:Type> <body:Block> <end:@R> => 
        Box::new(Stmt::FuncDef(name, params, ret_type, body, start, end)),
    <start:@L> RETURN <e:Expr> <end:@R> => Box::new(Stmt::Return(Some(e), start, end)),
    <start:@L> RETURN <end:@R> => Box::new(Stmt::Return(None, start, end)),
};

Block: Vec<Stmt> = {
    "{" <l:StmtList> "}" => l,
};

Expr: Box<Expr> = {
    <e:LogicalExpr> => e,
};

LogicalExpr: Box<Expr> = {
    <e:RelExpr> => e,
    NOT <f:Factor> => Box::new(Expr::Not(f)),   // 注意 NOT 优先级高于 AND/OR
    <e:LogicalExpr> AND <r:RelExpr> => Box::new(Expr::Op(Opcode::And, e, r)),
    <e:LogicalExpr> OR <r:RelExpr> => Box::new(Expr::Op(Opcode::Or, e, r)),
};

RelExpr: Box<Expr> = {
    <e:SimpleExpr> => e,
    <e:SimpleExpr> "=" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::Equal, e, s)),
    <e:SimpleExpr> "!=" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::NotEqual, e, s)),
    <e:SimpleExpr> "<" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::LessThan, e, s)),
    <e:SimpleExpr> ">" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::GreaterThan, e, s)),
    <e:SimpleExpr> "<=" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::LessOrEqual, e, s)),
    <e:SimpleExpr> ">=" <s:SimpleExpr> => Box::new(Expr::Op(Opcode::GreaterOrEqual, e, s)),
};

SimpleExpr: Box<Expr> = {
    <t:Term> => t,
    <e:SimpleExpr> "+" <t:Term> => Box::new(Expr::Op(Opcode::Add, e, t)),
    <e:SimpleExpr> "-" <t:Term> => Box::new(Expr::Op(Opcode::Sub, e, t)),
};

Term: Box<Expr> = {
    <f:Factor> => f,
    <t:Term> "*" <f:Factor> => Box::new(Expr::Op(Opcode::Mul, t, f)),
    <t:Term> "/" <f:Factor> => Box::new(Expr::Op(Opcode::Div, t, f)),
};

// 重构后的 Factor：支持一元负号和后缀索引
Factor: Box<Expr> = {
    <p:Primary> <s:IndexSuffix*> => {
        let mut expr = p;
        for (idx, start, end) in s {
            expr = Box::new(Expr::Index(expr, idx, start, end));
        }
        expr
    },
    <start:@L> "-" <f:Factor> <end:@R> => Box::new(Expr::Neg(f, start, end)),
};

// 原子表达式（不含后缀操作）
Primary: Box<Expr> = {
    "(" <e:Expr> ")" => e,
    <start:@L> <i:Id> "(" <args:ArgList> ")" <end:@R> => Box::new(Expr::Call(i, args, start, end)),
    <start:@L> <i:Id> <end:@R> => Box::new(Expr::Id(i, start, end)),
    <start:@L> <n:INT_NUM> <end:@R> => Box::new(Expr::Num(n.parse().unwrap(), start, end)),
    <start:@L> <f:FLOAT_NUM> <end:@R> => {
        let val = f.parse::<f64>().unwrap();
        Box::new(Expr::FloatLit(val, start, end))
    },
    <start:@L> <s:STRING> <end:@R> => {
        let content = s[1..s.len()-1].to_string();
        let content = content.replace("\\\"", "\"").replace("\\\\", "\\");
        Box::new(Expr::StringLit(content, start, end))
    },
    <start:@L> TRUE <end:@R> => Box::new(Expr::BoolLit(true, start, end)),
    <start:@L> FALSE <end:@R> => Box::new(Expr::BoolLit(false, start, end)),
    // 数组字面量
    <start:@L> "[" <elems:ArgList> "]" <end:@R> => Box::new(Expr::ArrayLit(elems, start, end)),
};

// 索引后缀：返回 (索引表达式, 起始位置, 结束位置)
IndexSuffix: (Box<Expr>, usize, usize) = {
    <start:@L> "[" <idx:Expr> "]" <end:@R> => (idx, start, end),
};

Type: Type = {
    INT => Type::Int,
    BOOL => Type::Bool,
    STRING_TYPE => Type::String,
    FLOAT_TYPE => Type::Float,
    ARRAY "<" <inner:Type> ">" => Type::Array(Box::new(inner)),   // ← 数组类型
};

IdList: Vec<String> = {
    <i:Id> "," <l:IdList> => {
        let mut v = vec![i];
        v.extend(l);
        v
    },
    <i:Id> => vec![i],
};

Id: String = {
    ID => <>.to_string(),
};

ParamList: Vec<(String, Type)> = {
    => vec![],
    <p:Param> => vec![p],
    <p:Param> "," <rest:ParamList> => {
        let mut v = vec![p];
        v.extend(rest);
        v
    },
};

Param: (String, Type) = {
    <t:Type> <id:Id> => (id, t),
};

ArgList: Vec<Expr> = {
    => vec![],
    <e:Expr> => vec![(*e)],
    <e:Expr> "," <rest:ArgList> => {
        let mut v = vec![(*e)];
        v.extend(rest);
        v
    },
}